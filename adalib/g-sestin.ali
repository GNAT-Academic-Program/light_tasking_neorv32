V "GNAT Lib v16"
A -nostdinc
A -O2
A -gnatA
A --RTS=/home/ohenley/capstones_2026_2027/neorv32_runtimes/install/light-tasking-neorv32/
A -mabi=ilp32
A -fno-tree-loop-distribute-patterns
